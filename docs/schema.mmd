    %% Org structure
    DEPARTMENT ||--o{ DEPARTMENT : "parent of"
    DEPARTMENT ||--o{ EMPLOYEE : "employs"
    EMPLOYEE |o--o| DEPARTMENT : "heads"

    %% Environmental
    DEPARTMENT ||--o{ ERP_OPERATION : "originates"
    VENDOR |o--o{ ERP_OPERATION : "supplies"
