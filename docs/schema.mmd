    ORGANIZATION ||--o{ DEPARTMENT : "has"
    ORGANIZATION ||--o{ EMPLOYEE : "has"
    ORGANIZATION ||--o{ CATEGORY : "has"
    ORGANIZATION ||--o{ EMISSION_FACTOR : "has"
    ORGANIZATION ||--o{ PRODUCT_ESG_PROFILE : "has"
    ORGANIZATION ||--o{ VENDOR : "has"
    ORGANIZATION ||--o{ ENVIRONMENTAL_GOAL : "has"
    ORGANIZATION ||--o{ ESG_POLICY : "has"
    ORGANIZATION ||--o{ TRAINING : "runs"
    ORGANIZATION ||--o{ BADGE : "has"
    ORGANIZATION ||--o{ REWARD : "has"
    ORGANIZATION ||--|| ESG_CONFIGURATION : "configures"
    ORGANIZATION ||--o{ FRAMEWORK_MAPPING : "adopts"
    ORGANIZATION ||--o{ FILE : "stores"
