    ORGANIZATION ||--o{ NOTIFICATION : "sends"
    ORGANIZATION ||--o{ ANALYTICS_SNAPSHOT : "aggregates"
    ORGANIZATION ||--o{ KPI_METRIC : "tracks"
    ORGANIZATION ||--o{ DEPARTMENT_RANKING : "ranks"
