    EMISSION_FACTOR ||--o{ CARBON_TRANSACTION : "used in"
    DEPARTMENT ||--o{ CARBON_TRANSACTION : "attributed"
    PRODUCT_ESG_PROFILE |o--o{ CARBON_TRANSACTION : "linked"
    VENDOR |o--o{ CARBON_TRANSACTION : "Scope 3 source"
    DEPARTMENT |o--o{ ENVIRONMENTAL_GOAL : "owns"
    ENVIRONMENTAL_GOAL ||--o{ GOAL_FORECAST : "projected"

    %% Social
    CATEGORY ||--o{ CSR_ACTIVITY : "classifies"
    CATEGORY ||--o{ TRAINING : "classifies"
    EMPLOYEE ||--o{ CSR_ACTIVITY : "organizes"
    CSR_ACTIVITY ||--o{ EMPLOYEE_PARTICIPATION : "has"
    EMPLOYEE ||--o{ EMPLOYEE_PARTICIPATION : "joins"
    EMPLOYEE ||--o{ EMPLOYEE_PARTICIPATION : "approves"
